{
  "nodes": [
    {
      "id": "web-client",
      "name": "Web client",
      "kind": "client",
      "layer": "clients",
      "summary": "The storefront in the browser.",
      "interfaces": [],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "gateway",
      "name": "API gateway",
      "kind": "service",
      "layer": "edge",
      "summary": "Terminates HTTP and routes requests.",
      "interfaces": [],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "router",
      "name": "Router",
      "kind": "module",
      "parent": "gateway",
      "layer": "edge",
      "summary": "Maps routes to services.",
      "interfaces": [
        "router.checkout",
        "router.lookup",
        "router.refund"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "auth",
      "name": "Auth",
      "kind": "module",
      "parent": "gateway",
      "layer": "edge",
      "summary": "Checks the session token.",
      "interfaces": [
        "auth.check"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "orders",
      "name": "Orders",
      "kind": "service",
      "layer": "core",
      "summary": "Creates and reads orders; scores each order for fraud before charging.",
      "interfaces": [
        "orders.create",
        "orders.get"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "payments",
      "name": "Payments",
      "kind": "service",
      "layer": "core",
      "summary": "Charges and refunds cards through the PSP.",
      "interfaces": [
        "payments.charge",
        "payments.refund"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "fraud",
      "name": "Fraud check",
      "kind": "service",
      "layer": "core",
      "summary": "Scores an order before it is charged.",
      "interfaces": [
        "fraud.score"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "orders-db",
      "name": "Orders DB",
      "kind": "datastore",
      "layer": "data",
      "summary": "Postgres orders table.",
      "interfaces": [
        "orders-db.get",
        "orders-db.put"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "events",
      "name": "Event bus",
      "kind": "queue",
      "layer": "data",
      "summary": "Order lifecycle events.",
      "interfaces": [
        "events.order-placed",
        "events.order-refunded"
      ],
      "leaf": true,
      "stateful": false
    }
  ],
  "edges": [
    {
      "id": "emits:orders-\u003eevents",
      "from": "orders",
      "to": "events",
      "kind": "emits",
      "label": "order-placed",
      "interfaces": [
        "events.order-placed"
      ],
      "derived": true
    },
    {
      "id": "calls:orders-\u003efraud",
      "from": "orders",
      "to": "fraud",
      "kind": "calls",
      "label": "score",
      "interfaces": [
        "fraud.score"
      ],
      "derived": true
    },
    {
      "id": "calls:orders-\u003eorders-db",
      "from": "orders",
      "to": "orders-db",
      "kind": "calls",
      "label": "2 interfaces",
      "interfaces": [
        "orders-db.get",
        "orders-db.put"
      ],
      "derived": true
    },
    {
      "id": "calls:orders-\u003epayments",
      "from": "orders",
      "to": "payments",
      "kind": "calls",
      "label": "charge",
      "interfaces": [
        "payments.charge"
      ],
      "derived": true
    },
    {
      "id": "emits:payments-\u003eevents",
      "from": "payments",
      "to": "events",
      "kind": "emits",
      "label": "order-refunded",
      "interfaces": [
        "events.order-refunded"
      ],
      "derived": true
    },
    {
      "id": "calls:router-\u003eauth",
      "from": "router",
      "to": "auth",
      "kind": "calls",
      "label": "check",
      "interfaces": [
        "auth.check"
      ],
      "derived": true
    },
    {
      "id": "calls:router-\u003eorders",
      "from": "router",
      "to": "orders",
      "kind": "calls",
      "label": "2 interfaces",
      "interfaces": [
        "orders.create",
        "orders.get"
      ],
      "derived": true
    },
    {
      "id": "calls:router-\u003epayments",
      "from": "router",
      "to": "payments",
      "kind": "calls",
      "label": "refund",
      "interfaces": [
        "payments.refund"
      ],
      "derived": true
    },
    {
      "id": "calls:web-client-\u003erouter",
      "from": "web-client",
      "to": "router",
      "kind": "calls",
      "label": "3 interfaces",
      "interfaces": [
        "router.checkout",
        "router.lookup",
        "router.refund"
      ],
      "derived": true
    }
  ]
}
