{
  "flow": "downstream-request",
  "entry": "listener.accept",
  "caller": "downstream-client",
  "interfaces": [
    "access-log.log",
    "backend-host.handle",
    "canary-host.handle",
    "circuit-breakers.release",
    "circuit-breakers.try-acquire",
    "cluster-manager.choose-host",
    "cluster-manager.eject-host",
    "conn-pool.new-stream",
    "conn-pool.release-stream",
    "filter-manager.decode-headers",
    "http-connection-manager.on-request",
    "http1-codec.decode-headers",
    "listener.accept",
    "load-balancer.pick",
    "local-ratelimit.decode-headers",
    "outlier-detector.put-result",
    "rbac.decode-headers",
    "retry-state.reset",
    "retry-state.should-retry",
    "route-matcher.route",
    "router.decode-headers",
    "upstream-request.send",
    "virtual-host.get-route"
  ],
  "components": [
    "access-log",
    "backend-host",
    "canary-host",
    "circuit-breakers",
    "cluster-manager",
    "conn-pool",
    "downstream-client",
    "filter-manager",
    "http-connection-manager",
    "http1-codec",
    "listener",
    "load-balancer",
    "local-ratelimit",
    "outlier-detector",
    "rbac",
    "retry-state",
    "route-matcher",
    "router",
    "upstream-request",
    "virtual-host"
  ],
  "choices": [
    {
      "key": "load-balancer.pick.seed",
      "interface": "load-balancer.pick",
      "name": "seed",
      "options": [
        "0",
        "1",
        "2"
      ],
      "default": "0",
      "title": "Seed the index"
    }
  ],
  "state": [
    {
      "component": "access-log",
      "initial": {
        "count": 0,
        "last": null
      }
    },
    {
      "component": "circuit-breakers",
      "initial": {
        "connections": 0,
        "pending": 0,
        "requests": 0,
        "retries": 0
      }
    },
    {
      "component": "cluster-manager",
      "initial": {
        "addresses": {
          "c1": "10.1.9.21:8080",
          "h1": "10.1.0.11:8080",
          "h2": "10.1.0.12:8080",
          "h3": "10.1.0.13:8080"
        },
        "clusters": {
          "backend": {
            "hosts": [
              "h1",
              "h2",
              "h3"
            ],
            "lb_policy": "ROUND_ROBIN"
          },
          "canary": {
            "hosts": [
              "c1"
            ],
            "lb_policy": "ROUND_ROBIN"
          }
        },
        "ejected": []
      }
    },
    {
      "component": "conn-pool",
      "initial": {
        "ready_clients": {
          "c1": 1,
          "h1": 1,
          "h2": 1,
          "h3": 1
        }
      }
    },
    {
      "component": "listener",
      "initial": {
        "address": "0.0.0.0:10000",
        "default_filter_chain": null,
        "filter_chains": [
          {
            "name": "private-http",
            "source_prefix_ranges": [
              "10.0.0.0/8",
              "192.168.0.0/16"
            ]
          }
        ]
      }
    },
    {
      "component": "load-balancer",
      "initial": {
        "rr": {}
      }
    },
    {
      "component": "outlier-detector",
      "initial": {
        "clusters": [
          "backend"
        ],
        "consecutive_5xx": {
          "h1": 0,
          "h2": 0,
          "h3": 0
        },
        "ejections_active": 0
      }
    },
    {
      "component": "rbac",
      "initial": {
        "action": "DENY",
        "policies": {
          "deny-admin": {
            "path_prefix": "/admin/"
          }
        }
      }
    },
    {
      "component": "route-matcher",
      "initial": {
        "virtual_hosts": [
          {
            "domains": [
              "api.example.com"
            ],
            "name": "api",
            "routes": [
              {
                "direct_response": {
                  "body": "ok",
                  "status": 200
                },
                "match": {
                  "path": "/healthz"
                },
                "name": "healthz"
              },
              {
                "match": {
                  "prefix": "/account/"
                },
                "name": "account-https",
                "redirect": {
                  "https_redirect": true
                }
              },
              {
                "match": {
                  "headers": [
                    {
                      "exact": "true",
                      "name": "x-canary"
                    }
                  ],
                  "prefix": "/api/"
                },
                "name": "api-canary",
                "route": {
                  "cluster": "canary"
                }
              },
              {
                "match": {
                  "prefix": "/api/"
                },
                "name": "api",
                "route": {
                  "cluster": "backend",
                  "retry_policy": {
                    "per_try_timeout_ms": 2000,
                    "retriable_status_codes": [
                      503
                    ],
                    "retry_on": [
                      "connect-failure",
                      "reset",
                      "retriable-status-codes"
                    ]
                  }
                }
              },
              {
                "match": {
                  "prefix": "/admin/"
                },
                "name": "admin",
                "route": {
                  "cluster": "backend"
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "faultable": [
    "access-log",
    "access-log.log",
    "backend-host",
    "backend-host.handle",
    "canary-host",
    "canary-host.handle",
    "circuit-breakers",
    "circuit-breakers.release",
    "circuit-breakers.try-acquire",
    "cluster-manager",
    "cluster-manager.choose-host",
    "cluster-manager.eject-host",
    "conn-pool",
    "conn-pool.new-stream",
    "conn-pool.release-stream",
    "filter-manager",
    "filter-manager.decode-headers",
    "http-connection-manager",
    "http-connection-manager.on-request",
    "http1-codec",
    "http1-codec.decode-headers",
    "listener",
    "listener.accept",
    "load-balancer",
    "load-balancer.pick",
    "local-ratelimit",
    "local-ratelimit.decode-headers",
    "outlier-detector",
    "outlier-detector.put-result",
    "rbac",
    "rbac.decode-headers",
    "retry-state",
    "retry-state.reset",
    "retry-state.should-retry",
    "route-matcher",
    "route-matcher.route",
    "router",
    "router.decode-headers",
    "upstream-request",
    "upstream-request.send",
    "virtual-host",
    "virtual-host.get-route"
  ],
  "scenarios": [
    "canary-by-header",
    "canary-timeout",
    "connect-failure-exhausted",
    "direct-response-healthz",
    "ejected-host-skipped",
    "happy-path",
    "headers-too-large",
    "https-redirect",
    "lb-seed-starts-at-h2",
    "local-rate-limited",
    "no-filter-chain",
    "no-route",
    "no-virtual-host",
    "outlier-ejects-h1",
    "pending-overflow",
    "per-try-timeout-retried",
    "rbac-denied",
    "retries-exhausted",
    "retry-overflow",
    "upstream-500-not-retried",
    "upstream-503-retried",
    "upstream-reset-retried"
  ]
}
