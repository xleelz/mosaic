{
  "nodes": [
    {
      "id": "downstream-client",
      "name": "Downstream client",
      "kind": "client",
      "layer": "clients",
      "summary": "An HTTP/1.1 client calling the proxy.",
      "interfaces": [],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "envoy",
      "name": "Envoy",
      "kind": "service",
      "layer": "proxy",
      "summary": "The proxy process; one worker thread handles the connection.",
      "interfaces": [],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "listener",
      "name": "Listener",
      "kind": "module",
      "parent": "envoy",
      "layer": "proxy",
      "summary": "Accepts the connection and picks a filter chain by the connection's addresses.",
      "interfaces": [
        "listener.accept"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "http-connection-manager",
      "name": "HTTP connection manager",
      "kind": "module",
      "parent": "envoy",
      "layer": "proxy",
      "summary": "The network filter that turns bytes into streams, resolves the route, runs the HTTP filters and logs the stream.",
      "interfaces": [
        "http-connection-manager.on-request"
      ],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "http1-codec",
      "name": "HTTP/1 codec",
      "kind": "module",
      "parent": "http-connection-manager",
      "layer": "proxy",
      "summary": "Parses request headers and enforces the header size limit.",
      "interfaces": [
        "http1-codec.decode-headers"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "filter-manager",
      "name": "Filter manager",
      "kind": "module",
      "parent": "http-connection-manager",
      "layer": "proxy",
      "summary": "Runs the decoder filters in order until one stops iteration.",
      "interfaces": [
        "filter-manager.decode-headers"
      ],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "local-ratelimit",
      "name": "Local rate limit filter",
      "kind": "module",
      "parent": "filter-manager",
      "layer": "filters",
      "summary": "A token bucket shared by the worker's requests; an empty bucket answers 429.",
      "interfaces": [
        "local-ratelimit.decode-headers"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "rbac",
      "name": "RBAC filter",
      "kind": "module",
      "parent": "filter-manager",
      "layer": "filters",
      "summary": "Role-based access control; a DENY policy that matches answers 403.",
      "interfaces": [
        "rbac.decode-headers"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "router",
      "name": "Router filter",
      "kind": "module",
      "parent": "filter-manager",
      "layer": "filters",
      "summary": "The terminal filter. Sends direct responses and redirects, sets the timeouts and forwards to the cluster, retrying per the route's policy.",
      "interfaces": [
        "router.decode-headers"
      ],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "retry-state",
      "name": "Retry state",
      "kind": "module",
      "parent": "router",
      "layer": "filters",
      "summary": "Decides each retry from retry_on, the retries left and the cluster's retry circuit breaker.",
      "interfaces": [
        "retry-state.reset",
        "retry-state.should-retry"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "upstream-request",
      "name": "Upstream request",
      "kind": "module",
      "parent": "router",
      "layer": "filters",
      "summary": "One attempt. Picks a host, gets a stream from the pool, sends, and reports the outcome to outlier detection and the retry state.",
      "interfaces": [
        "upstream-request.send"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "route-matcher",
      "name": "Route matcher",
      "kind": "module",
      "parent": "http-connection-manager",
      "layer": "routing",
      "summary": "Finds the virtual host by the authority header, then asks it for the first matching route.",
      "interfaces": [
        "route-matcher.route"
      ],
      "leaf": false,
      "stateful": true
    },
    {
      "id": "virtual-host",
      "name": "Virtual host",
      "kind": "module",
      "parent": "route-matcher",
      "layer": "routing",
      "summary": "Walks its routes in order and returns the first whose path and header matchers match.",
      "interfaces": [
        "virtual-host.get-route"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "cluster-manager",
      "name": "Cluster manager",
      "kind": "module",
      "parent": "envoy",
      "layer": "upstream",
      "summary": "The worker's thread-local clusters, their host sets and host health.",
      "interfaces": [
        "cluster-manager.choose-host",
        "cluster-manager.eject-host"
      ],
      "leaf": false,
      "stateful": true
    },
    {
      "id": "load-balancer",
      "name": "Round-robin load balancer",
      "kind": "module",
      "parent": "cluster-manager",
      "layer": "upstream",
      "summary": "Picks hosts in turn from the healthy set, starting at a random index.",
      "interfaces": [
        "load-balancer.pick"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "circuit-breakers",
      "name": "Circuit breakers",
      "kind": "limiter",
      "parent": "cluster-manager",
      "layer": "upstream",
      "summary": "The cluster's resource manager. Counts connections, pending requests, requests and retries against their maximums.",
      "interfaces": [
        "circuit-breakers.release",
        "circuit-breakers.try-acquire"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "conn-pool",
      "name": "Connection pool",
      "kind": "module",
      "parent": "cluster-manager",
      "layer": "upstream",
      "summary": "Per-host HTTP/1 pool. Attaches to a ready connection, or queues a pending stream and connects.",
      "interfaces": [
        "conn-pool.new-stream",
        "conn-pool.release-stream"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "outlier-detector",
      "name": "Outlier detector",
      "kind": "module",
      "parent": "cluster-manager",
      "layer": "upstream",
      "summary": "Counts consecutive 5xx per host and ejects a host at the threshold, within max_ejection_percent.",
      "interfaces": [
        "outlier-detector.put-result"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "access-log",
      "name": "Access log",
      "kind": "queue",
      "parent": "envoy",
      "layer": "proxy",
      "summary": "The stream's access log line, written when the stream ends.",
      "interfaces": [
        "access-log.log"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "backend",
      "name": "Cluster backend",
      "kind": "pool",
      "layer": "upstream-hosts",
      "summary": "Three interchangeable application hosts.",
      "interfaces": [],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "backend-host",
      "name": "Backend host",
      "kind": "engine",
      "parent": "backend",
      "layer": "upstream-hosts",
      "summary": "One host of cluster backend; its instances are h1, h2 and h3.",
      "interfaces": [
        "backend-host.handle"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "canary",
      "name": "Cluster canary",
      "kind": "pool",
      "layer": "upstream-hosts",
      "summary": "A single canary host, selected by header.",
      "interfaces": [],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "canary-host",
      "name": "Canary host",
      "kind": "engine",
      "parent": "canary",
      "layer": "upstream-hosts",
      "summary": "The canary host, instance c1.",
      "interfaces": [
        "canary-host.handle"
      ],
      "leaf": true,
      "stateful": false
    }
  ],
  "edges": [
    {
