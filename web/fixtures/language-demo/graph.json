{
  "nodes": [
    {
      "id": "kv-client",
      "name": "Store client",
      "kind": "client",
      "layer": "clients",
      "summary": "Sends puts and gets to the coordinator.",
      "interfaces": [],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "kv-coordinator",
      "name": "Store coordinator",
      "kind": "service",
      "layer": "kv",
      "summary": "Accepts client requests, writes at quorum and reads with a hedged request.",
      "interfaces": [
        "kv-coordinator.get",
        "kv-coordinator.put"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "kv-membership",
      "name": "Membership",
      "kind": "module",
      "layer": "kv",
      "summary": "Knows which replicas are alive.",
      "interfaces": [
        "kv-membership.live-replicas"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "kv-write-handler",
      "name": "Write response handler",
      "kind": "module",
      "layer": "kv",
      "summary": "Fans a mutation out to every live replica and waits for the quorum.",
      "interfaces": [
        "kv-write-handler.await"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "kv-node",
      "name": "Storage node",
      "kind": "service",
      "layer": "kv",
      "summary": "One copy of the storage process. A fixture names its instances.",
      "interfaces": [],
      "leaf": false,
      "stateful": false
    },
    {
      "id": "kv-replica",
      "name": "Replica verb handler",
      "kind": "module",
      "parent": "kv-node",
      "layer": "kv",
      "summary": "Applies writes and serves reads on its own node.",
      "interfaces": [
        "kv-replica.read",
        "kv-replica.write"
      ],
      "leaf": true,
      "stateful": false
    },
    {
      "id": "kv-memtable",
      "name": "Memtable",
      "kind": "datastore",
      "parent": "kv-node",
      "layer": "data",
      "summary": "Rows held by one node.",
      "interfaces": [
        "kv-memtable.get",
        "kv-memtable.put"
      ],
      "leaf": true,
      "stateful": true
    },
    {
      "id": "ed-user",
