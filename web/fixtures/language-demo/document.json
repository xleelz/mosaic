{
  "schema_version": 1,
  "id": "language-demo",
  "name": "Language demo",
  "description": "Three small systems that exercise instances, parallel joins, hedging, deadlines, timers, capacity, publish/subscribe, configs, fixtures, multi-step scenarios and trace assertions.",
  "components": [
    {
      "id": "kv-client",
      "name": "Store client",
      "kind": "client",
      "layer": "clients",
      "summary": "Sends puts and gets to the coordinator."
    },
    {
      "id": "kv-coordinator",
      "name": "Store coordinator",
      "kind": "service",
      "layer": "kv",
      "summary": "Accepts client requests, writes at quorum and reads with a hedged request."
    },
    {
      "id": "kv-membership",
      "name": "Membership",
      "kind": "module",
      "layer": "kv",
      "summary": "Knows which replicas are alive.",
      "state": {
        "initial": {
          "down": [],
          "nodes": [
            "n1",
            "n2",
            "n3"
          ]
        }
      }
    },
    {
      "id": "kv-write-handler",
      "name": "Write response handler",
      "kind": "module",
      "layer": "kv",
      "summary": "Fans a mutation out to every live replica and waits for the quorum."
    },
    {
      "id": "kv-node",
      "name": "Storage node",
      "kind": "service",
      "layer": "kv",
      "summary": "One copy of the storage process. A fixture names its instances."
    },
    {
      "id": "kv-replica",
      "name": "Replica verb handler",
      "kind": "module",
      "parent": "kv-node",
      "layer": "kv",
      "summary": "Applies writes and serves reads on its own node."
    },
    {
      "id": "kv-memtable",
      "name": "Memtable",
      "kind": "datastore",
      "parent": "kv-node",
      "layer": "data",
      "summary": "Rows held by one node.",
      "state": {
        "initial": {
          "rows": {}
        }
      }
    },
    {
      "id": "ed-user",
      "name": "Editor user",
      "kind": "client",
      "layer": "clients",
      "summary": "Opens, edits and saves files."
    },
    {
      "id": "ed-workbench",
      "name": "Workbench window",
      "kind": "service",
      "layer": "editor",
      "summary": "One editor window. Runs commands and the auto-save debounce.",
      "state": {
        "initial": {
          "dirty": false,
          "last_edit_ms": 0,
          "saves": 0,
          "superseded": 0
        }
      }
    },
    {
      "id": "ed-text-model",
      "name": "Text model",
      "kind": "module",
      "parent": "ed-workbench",
      "layer": "editor",
      "summary": "Holds open documents and fires a synchronous change event.",
      "state": {
        "initial": {
          "docs": {}
        }
      }
    },
    {
      "id": "ed-outline",
      "name": "Outline view",
      "kind": "module",
      "parent": "ed-workbench",
      "layer": "editor",
      "summary": "Rebuilds symbols when a document changes.",
      "state": {
        "initial": {
          "version": 0
        }
      }
    },
    {
      "id": "ed-diagnostics",
      "name": "Diagnostics",
      "kind": "module",
      "parent": "ed-workbench",
      "layer": "editor",
      "summary": "Re-lints a document when it changes. Its listener can throw.",
      "state": {
        "initial": {
          "version": 0
        }
      }
    },
    {
      "id": "ed-ext-host",
      "name": "Extension host",
      "kind": "service",
      "layer": "extensions",
      "summary": "Runs extensions on a single JavaScript thread.",
      "state": {
        "initial": {
          "activated": [],
          "synced_version": 0
        }
      },
      "capacity": {
        "concurrency": 1
      }
    },
    {
      "id": "ed-file-service",
      "name": "File service",
      "kind": "datastore",
      "layer": "data",
      "summary": "Reads and writes files on disk.",
      "state": {
        "initial": {
          "files": {}
        }
      }
    },
    {
      "id": "gpu-client",
      "name": "Inference client",
      "kind": "client",
      "layer": "clients",
      "summary": "Sends generation requests."
    },
    {
      "id": "gpu-api-server",
      "name": "API server",
      "kind": "service",
      "layer": "serving",
      "summary": "Accepts requests and consumes the engine's output stream.",
      "state": {
        "initial": {
          "streamed": 0
        }
      }
    },
    {
      "id": "gpu-engine-core",
      "name": "Engine core",
      "kind": "engine",
      "layer": "serving",
      "summary": "Admits requests and runs the scheduler step loop."
    },
    {
      "id": "gpu-scheduler",
      "name": "Scheduler",
      "kind": "module",
      "parent": "gpu-engine-core",
      "layer": "serving",
      "summary": "Tracks running sequences. At most two prefills run at once (max running sequences).",
      "state": {
        "initial": {
          "requests": {}
        }
      },
      "capacity": {
        "concurrency": 2,
        "queue_limit": 1
      }
    },
    {
      "id": "gpu-executor",
      "name": "Model executor",
      "kind": "module",
      "parent": "gpu-engine-core",
      "layer": "serving",
      "summary": "Runs one forward pass on every tensor-parallel rank and waits for the all-reduce."
    },
    {
      "id": "gpu-worker",
      "name": "GPU worker",
      "kind": "service",
      "layer": "gpu",
      "summary": "One tensor-parallel rank. A fixture names the ranks."
    }
  ],
  "interfaces": [
    {
      "id": "kv-coordinator.put",
      "component": "kv-coordinator",
      "name": "put",
      "kind": "rpc",
      "summary": "Write a row at quorum.",
      "errors": [
        {
          "code": "unavailable",
          "status": 503
        },
        {
          "code": "write-timeout",
          "status": 504
        }
      ],
      "latency_ms": 1,
      "behavior": [
        {
          "call": "kv-membership.live-replicas",
          "as": "live"
        },
        {
          "set": {
            "vars.quorum": "= config['kv-write-quorum']"
          }
        },
        {
          "if": "size(vars.live.value.replicas) \u003c vars.quorum",
          "then": [
            {
              "title": "Refuse before sending anything",
              "fail": {
                "code": "unavailable",
                "data": {
                  "alive": "= size(vars.live.value.replicas)",
                  "required": "= vars.quorum"
                },
                "status": 503
              }
            }
          ]
        },
        {
          "title": "The request budget covers every replica hop",
          "call": "kv-write-handler.await",
          "input": {
            "key": "= input.key",
            "quorum": "= vars.quorum",
            "replicas": "= vars.live.value.replicas",
            "value": "= input.value"
          },
          "as": "acks",
          "on_error": [
            {
              "title": "The join timed out",
              "when": "error.code == 'timeout'",
              "fail": {
                "code": "write-timeout",
                "data": "= error.data",
                "status": 504
              }
            },
            {
              "fail": "= error"
            }
          ],
          "deadline_ms": "= config['kv-request-deadline-ms']"
        },
        {
          "return": {
            "acks": "= vars.acks.value.acks",
            "key": "= input.key"
          }
        }
      ]
    },
    {
      "id": "kv-coordinator.get",
      "component": "kv-coordinator",
      "name": "get",
      "kind": "rpc",
      "summary": "Read a row with a hedged (speculative) request.",
      "latency_ms": 1,
      "behavior": [
        {
          "call": "kv-membership.live-replicas",
          "as": "live"
        },
        {
          "title": "Ask the closest replica, hedge to the next after the threshold",
          "as": "replica",
          "timeout_ms": "= config['kv-read-timeout-ms']",
          "steps": [
            {
              "call": "kv-replica.read",
              "input": {
                "key": "= input.key"
              },
              "as": "got",
              "on": "= vars.replica"
            },
            {
              "return": "= vars.got.value"
            }
          ],
          "parallel": "= vars.live.value.replicas",
          "join": {
            "need": 1
          },
          "stagger_ms": "= config['kv-speculative-threshold-ms']",
          "as_result": "reads"
        },
        {
          "return": "= vars.reads.results.filter(r, r.ok \u0026\u0026 !r.late)[0].value"
        }
      ]
    },
    {
      "id": "kv-membership.live-replicas",
      "component": "kv-membership",
      "name": "live-replicas",
      "kind": "function",
      "latency_ms": 0,
      "behavior": [
        {
          "return": {
            "replicas": "= state.nodes.filter(n, !(n in state.down))"
          }
        }
      ]
    },
    {
      "id": "kv-write-handler.await",
      "component": "kv-write-handler",
      "name": "await",
      "kind": "function",
      "latency_ms": 0,
      "behavior": [
        {
          "title": "Send to every live replica, wait for the quorum",
          "as": "replica",
          "timeout_ms": "= config['kv-write-timeout-ms']",
          "steps": [
            {
              "call": "kv-replica.write",
              "input": {
                "key": "= input.key",
                "value": "= input.value"
              },
              "on": "= vars.replica"
            }
          ],
          "parallel": "= input.replicas",
          "join": {
            "need": "= input.quorum"
          },
          "as_result": "acks",
          "on_insufficient": {
            "code": "write-failure",
            "status": 500
          }
        },
        {
          "return": {
            "acks": "= vars.acks.received"
          }
        }
      ]
    },
    {
      "id": "kv-replica.write",
      "component": "kv-replica",
      "name": "write",
      "kind": "rpc",
      "latency_ms": 3,
      "behavior": [
        {
          "call": "kv-memtable.put",
          "input": {
            "key": "= input.key",
            "value": "= input.value",
            "written_at": "= now"
          }
        },
        {
          "return": {
            "replica": "= self"
          }
        }
      ]
    },
    {
      "id": "kv-replica.read",
      "component": "kv-replica",
      "name": "read",
      "kind": "rpc",
      "latency_ms": 2,
      "behavior": [
        {
          "call": "kv-memtable.get",
          "input": {
            "key": "= input.key"
          },
          "as": "row"
        },
        {
          "return": {
            "replica": "= self",
            "value": "= vars.row.value.value"
          }
        }
      ]
    },
    {
      "id": "kv-memtable.put",
      "component": "kv-memtable",
      "name": "put",
      "kind": "function",
      "latency_ms": 1,
      "store": {
        "table": "rows",
        "op": "put",
        "key": "= input.key",
        "value": "= input"
      }
    },
    {
      "id": "kv-memtable.get",
      "component": "kv-memtable",
      "name": "get",
      "kind": "function",
      "latency_ms": 1,
      "store": {
        "table": "rows",
        "op": "get",
        "key": "= input.key"
      }
    },
    {
      "id": "ed-workbench.open-file",
      "component": "ed-workbench",
      "name": "open-file",
      "kind": "function",
      "summary": "Open a file, load it into the text model and activate startup extensions.",
      "latency_ms": 2,
      "behavior": [
        {
          "call": "ed-file-service.read",
          "input": {
            "uri": "= input.uri"
          },
          "as": "file"
        },
        {
          "call": "ed-text-model.load",
          "input": {
            "content": "= vars.file.value.content",
            "uri": "= input.uri"
          }
        },
        {
          "title": "Activate startup extensions together (Promise.all)",
          "as": "ext",
          "steps": [
            {
              "call": "ed-ext-host.activate",
              "input": {
                "ext": "= vars.ext"
              }
            }
          ],
          "parallel": "= config['ed-startup-extensions']",
          "join": {
            "need": "all"
          },
          "as_result": "activations"
        },
        {
          "return": {
            "activated": "= vars.activations.received",
            "uri": "= input.uri"
          }
        }
      ]
    },
    {
      "id": "ed-workbench.type-text",
      "component": "ed-workbench",
      "name": "type-text",
      "kind": "function",
      "summary": "Apply one edit and (re)schedule the auto-save.",
      "latency_ms": 1,
      "behavior": [
        {
          "call": "ed-text-model.apply-edit",
          "input": {
            "text": "= input.text",
            "uri": "= input.uri"
          },
          "as": "edit"
        },
        {
          "set": {
            "state.dirty": true,
            "state.last_edit_ms": "= now"
          }
        },
        {
          "title": "Debounce the auto-save",
          "input": {
            "scheduled_at": "= now",
            "uri": "= input.uri"
          },
          "emit": "ed-workbench.autosave",
          "after_ms": "= config['ed-auto-save-delay-ms']"
        },
        {
          "return": {
            "version": "= vars.edit.value.version"
          }
        }
      ]
    },
    {
      "id": "ed-workbench.type-burst",
      "component": "ed-workbench",
      "name": "type-burst",
      "kind": "function",
      "summary": "Several keystrokes in a row.",
      "latency_ms": 0,
      "behavior": [
        {
          "as": "ch",
          "foreach": "= input.chars",
          "steps": [
            {
              "call": "ed-workbench.type-text",
              "input": {
                "text": "= vars.ch",
                "uri": "= input.uri"
              }
            }
          ]
        },
        {
          "return": {
            "typed": "= size(input.chars)"
          }
        }
      ]
    },
    {
      "id": "ed-workbench.autosave",
      "component": "ed-workbench",
      "name": "autosave",
      "kind": "event",
      "summary": "Delivered after the debounce delay; skipped when a newer edit rescheduled it.",
      "latency_ms": 0,
      "behavior": [
        {
          "if": "state.last_edit_ms \u003e input.scheduled_at",
          "then": [
            {
              "set": {
                "state.superseded": "= state.superseded + 1"
              }
            },
            {
              "return": {
                "reason": "superseded",
                "saved": false
              }
            }
          ]
        },
        {
          "call": "ed-workbench.save-file",
          "input": {
            "uri": "= input.uri"
          }
        },
        {
          "return": {
            "saved": true
          }
        }
      ]
    },
    {
      "id": "ed-workbench.save-file",
      "component": "ed-workbench",
      "name": "save-file",
      "kind": "function",
      "summary": "Save a document, giving extensions a bounded chance to take part.",
      "latency_ms": 1,
      "behavior": [
        {
          "call": "ed-text-model.snapshot",
          "input": {
            "uri": "= input.uri"
          },
          "as": "doc"
        },
        {
          "title": "Will-save participants share one budget",
          "call": "ed-ext-host.will-save",
          "input": {
            "uri": "= input.uri"
          },
          "as": "participants",
          "on_error": "continue",
          "deadline_ms": "= config['ed-save-participant-timeout-ms']"
        },
        {
          "call": "ed-file-service.write",
          "input": {
            "content": "= vars.doc.value.content",
            "uri": "= input.uri"
          }
        },
        {
          "set": {
            "state.dirty": false,
            "state.saves": "= state.saves + 1"
          }
        },
        {
          "return": {
            "participants_ok": "= vars.participants.ok",
            "saved": true
          }
        }
      ]
    },
    {
      "id": "ed-text-model.load",
      "component": "ed-text-model",
      "name": "load",
      "kind": "function",
      "latency_ms": 1,
      "behavior": [
        {
          "set": {
            "state.docs": "= merge(state.docs, {input.uri: {'content': input.content, 'version': 1}})"
          }
        }
      ]
    },
    {
      "id": "ed-text-model.apply-edit",
      "component": "ed-text-model",
      "name": "apply-edit",
      "kind": "function",
      "latency_ms": 1,
      "behavior": [
        {
          "set": {
            "vars.doc": "= state.docs[input.uri]"
          }
        },
        {
          "set": {
            "state.docs": "= merge(state.docs, {input.uri: {'content': vars.doc.content + input.text, 'version': vars.doc.version + 1}})"
          }
        },
        {
          "title": "Fire onDidChange synchronously",
          "input": {
            "uri": "= input.uri",
            "version": "= vars.doc.version + 1"
          },
          "publish": "ed-text-model.on-did-change",
          "delivery": "sync"
        },
        {
          "set": {
            "ctx.after_publish_ms": "= now"
          }
        },
        {
          "return": {
            "version": "= vars.doc.version + 1"
          }
        }
      ]
    },
    {
      "id": "ed-text-model.on-did-change",
      "component": "ed-text-model",
      "name": "on-did-change",
      "kind": "event",
      "summary": "The change event topic."
    },
    {
      "id": "ed-text-model.snapshot",
      "component": "ed-text-model",
      "name": "snapshot",
      "kind": "function",
      "latency_ms": 0,
      "behavior": [
        {
          "return": "= state.docs[input.uri]"
        }
      ]
    },
    {
      "id": "ed-outline.on-document-change",
      "component": "ed-outline",
      "name": "on-document-change",
      "kind": "event",
      "latency_ms": 3,
      "behavior": [
        {
          "set": {
            "state.version": "= input.version"
          }
        }
      ],
      "subscribe": [
        "ed-text-model.on-did-change"
      ]
    },
    {
      "id": "ed-diagnostics.on-document-change",
      "component": "ed-diagnostics",
      "name": "on-document-change",
      "kind": "event",
      "errors": [
        {
          "code": "listener-threw",
          "status": 500
        }
      ],
      "latency_ms": 4,
      "behavior": [
        {
          "set": {
            "state.version": "= input.version"
          }
        }
      ],
      "subscribe": [
        "ed-text-model.on-did-change"
      ]
    },
    {
      "id": "ed-ext-host.on-document-change",
      "component": "ed-ext-host",
      "name": "on-document-change",
      "kind": "event",
      "latency_ms": 2,
      "behavior": [
        {
          "set": {
            "state.synced_version": "= input.version"
          }
        }
      ],
      "subscribe": [
        "ed-text-model.on-did-change"
      ]
    },
    {
      "id": "ed-ext-host.activate",
      "component": "ed-ext-host",
      "name": "activate",
      "kind": "rpc",
      "summary": "Activate one extension on the host's single thread.",
      "latency_ms": 20,
      "behavior": [
        {
          "if": "input.ext in state.activated",
          "then": [
            {
              "return": {
                "already": true,
                "ext": "= input.ext"
              }
            }
          ]
        },
        {
          "set": {
            "state.activated": "= state.activated + [input.ext]"
          }
        },
        {
          "return": {
            "already": false,
            "ext": "= input.ext"
          }
        }
      ]
    },
    {
      "id": "ed-ext-host.will-save",
      "component": "ed-ext-host",
      "name": "will-save",
      "kind": "rpc",
      "summary": "Let extensions edit the document before it is written.",
      "latency_ms": 10
    },
    {
      "id": "ed-file-service.read",
      "component": "ed-file-service",
      "name": "read",
      "kind": "function",
      "latency_ms": 2,
      "store": {
        "table": "files",
        "op": "get",
        "key": "= input.uri"
      }
    },
    {
      "id": "ed-file-service.write",
      "component": "ed-file-service",
      "name": "write",
      "kind": "function",
      "latency_ms": 5,
      "store": {
        "table": "files",
        "op": "put",
        "key": "= input.uri",
        "value": "= input"
      }
    },
    {
      "id": "gpu-api-server.generate",
      "component": "gpu-api-server",
      "name": "generate",
      "kind": "http",
      "attributes": {
        "method": "POST",
        "path": "/v1/completions"
      },
      "latency_ms": 1,
      "behavior": [
        {
          "call": "gpu-engine-core.add-request",
          "input": {
            "max_tokens": "= input.max_tokens",
            "prompt_tokens": "= input.prompt_tokens",
            "request_id": "= input.request_id"
          },
          "as": "added"
        },
        {
          "return": {
            "prefill_ms": "= vars.added.value.prefill_ms",
            "request_id": "= input.request_id"
          }
        }
      ]
    },
    {
      "id": "gpu-api-server.generate-batch",
      "component": "gpu-api-server",
      "name": "generate-batch",
      "kind": "http",
      "summary": "Several requests arriving at once.",
      "attributes": {
        "method": "POST",
        "path": "/v1/batch"
      },
      "latency_ms": 0,
      "behavior": [
        {
          "as": "req",
          "steps": [
            {
              "call": "gpu-engine-core.add-request",
              "input": "= vars.req"
            }
          ],
          "parallel": "= input.requests",
          "join": {
            "need": 1
          },
          "as_result": "admitted"
        },
        {
          "return": {
            "admitted": "= vars.admitted.received",
            "failed": "= vars.admitted.failed"
          }
        }
      ]
    },
    {
      "id": "gpu-api-server.on-output",
      "component": "gpu-api-server",
      "name": "on-output",
      "kind": "stream",
      "latency_ms": 0,
      "behavior": [
        {
          "set": {
            "state.streamed": "= state.streamed + size(input.request_ids)"
          }
        }
      ],
      "subscribe": [
        "gpu-engine-core.outputs"
      ]
    },
    {
      "id": "gpu-engine-core.add-request",
      "component": "gpu-engine-core",
      "name": "add-request",
      "kind": "function",
      "latency_ms": 0,
      "behavior": [
        {
          "call": "gpu-scheduler.prefill",
          "input": "= input",
          "as": "pre"
        },
        {
          "return": {
            "prefill_ms": "= vars.pre.value.step_ms"
          }
        }
      ]
    },
    {
      "id": "gpu-engine-core.outputs",
      "component": "gpu-engine-core",
      "name": "outputs",
      "kind": "event",
      "summary": "Tokens produced by one step."
    },
    {
      "id": "gpu-engine-core.step",
      "component": "gpu-engine-core",
      "name": "step",
      "kind": "function",
      "summary": "One scheduler step; a flow repeats it.",
      "latency_ms": 0,
      "behavior": [
        {
          "call": "gpu-scheduler.schedule",
          "as": "sch"
        },
        {
          "if": "size(vars.sch.value.running) == 0",
          "then": [
            {
              "return": {
                "idle": true,
                "running": 0
              }
            }
          ]
        },
        {
          "call": "gpu-executor.execute-model",
          "input": {
            "phase": "decode",
            "tokens": "= size(vars.sch.value.running)"
          }
        },
        {
          "call": "gpu-scheduler.commit-step",
          "input": {
            "running": "= vars.sch.value.running"
          }
        },
        {
          "input": {
            "request_ids": "= vars.sch.value.running"
          },
          "publish": "gpu-engine-core.outputs"
        },
        {
          "return": {
            "idle": false,
            "running": "= size(vars.sch.value.running)"
          }
        }
      ]
    },
    {
      "id": "gpu-scheduler.prefill",
      "component": "gpu-scheduler",
      "name": "prefill",
      "kind": "function",
      "summary": "Admit a request and run its prefill. Holds one of the running-sequence slots.",
      "errors": [
        {
          "code": "overloaded",
          "status": 429,
          "retryable": true
        }
      ],
      "latency_ms": 0,
      "behavior": [
        {
          "call": "gpu-executor.execute-model",
          "input": {
            "phase": "prefill",
            "tokens": "= input.prompt_tokens"
          },
          "as": "fw"
        },
        {
          "set": {
            "state.requests": "= merge(state.requests, {input.request_id: {'tokens': input.prompt_tokens, 'generated': 1, 'max_tokens': input.max_tokens}})"
          }
        },
        {
          "return": {
            "step_ms": "= vars.fw.value.step_ms"
          }
        }
      ]
    },
    {
      "id": "gpu-scheduler.schedule",
      "component": "gpu-scheduler",
      "name": "schedule",
      "kind": "function",
      "latency_ms": 0,
      "behavior": [
        {
          "return": {
            "running": "= state.requests.filter(k, state.requests[k].generated \u003c state.requests[k].max_tokens)"
          }
        }
      ]
    },
    {
      "id": "gpu-scheduler.commit-step",
      "component": "gpu-scheduler",
      "name": "commit-step",
      "kind": "function",
      "latency_ms": 0,
      "behavior": [
        {
          "as": "rid",
          "foreach": "= input.running",
          "steps": [
            {
              "set": {
                "state.requests": "= merge(state.requests, {vars.rid: {'generated': state.requests[vars.rid].generated + 1}})"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "gpu-executor.execute-model",
      "component": "gpu-executor",
      "name": "execute-model",
      "kind": "function",
      "errors": [
        {
          "code": "worker-failed",
          "status": 500
        }
      ],
      "latency_ms": 0,
      "behavior": [
        {
          "title": "Forward on every rank, then all-reduce",
          "as": "rank",
          "steps": [
            {
              "call": "gpu-worker.forward",
              "input": {
                "phase": "= input.phase",
                "tokens": "= input.tokens"
              },
              "on": "= vars.rank"
            }
          ],
          "parallel": "= ['rank0', 'rank1', 'rank2', 'rank3'].slice(0, config['gpu-tensor-parallel-size'])",
          "join": {
            "need": "all"
          },
          "as_result": "shards",
          "on_insufficient": {
            "code": "worker-failed",
            "status": 500
          }
        },
        {
          "return": {
            "step_ms": "= vars.shards.duration_ms"
          }
        }
      ]
    },
    {
      "id": "gpu-worker.forward",
      "component": "gpu-worker",
      "name": "forward",
      "kind": "rpc",
      "summary": "One forward pass. Prefill time grows with the prompt; a decode step is fixed.",
      "latency_ms": "= input.phase == 'prefill' ? 2 + int(input.tokens) / int(config['gpu-prefill-tokens-per-ms']) : int(config['gpu-decode-ms'])",
      "behavior": [
        {
          "return": {
            "rank": "= self",
            "tokens": "= input.tokens"
          }
        }
      ]
    }
  ],
