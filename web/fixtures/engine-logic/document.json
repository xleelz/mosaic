{
  "schema_version": 1,
  "id": "engine-logic",
  "name": "Engine logic",
  "description": "The engine refined into a scheduler and a worker (a refinement of shop's engine).",
  "components": [
    {
      "id": "metrics",
      "attributes": {
        "boundary": true
      }
    },
    {
      "id": "scheduler"
    },
    {
      "id": "worker"
    }
  ],
  "interfaces": [
    {
      "id": "metrics.record",
      "component": "metrics",
      "name": "record"
    },
    {
      "id": "scheduler.submit",
      "component": "scheduler",
      "name": "submit",
      "latency_ms": 5,
      "behavior": [
        {
          "call": "worker.execute",
          "input": {
            "prompt": "=input.prompt"
          },
          "as": "w"
        },
        {
          "return": {
            "text": "=vars.w.value.out"
          }
        }
      ],
      "implements": "engine.run"
    },
    {
      "id": "worker.execute",
      "component": "worker",
      "name": "execute",
      "errors": [
        {
          "code": "overloaded",
          "status": 503,
          "retryable": true
        }
      ],
      "latency_ms": 20,
      "behavior": [
        {
          "call": "metrics.record"
        },
        {
          "return": {
            "out": "=input.prompt + '!'"
          }
        }
      ]
    }
  ],
  "links": [],
  "schemas": [],
  "flows": [],
  "scenarios": [],
  "level": "service",
  "refines": {
    "ontology": "shop",
    "component": "engine",
    "revision": "1"
  }
}
