{
  "schema_version": 1,
  "id": "shop",
  "name": "Shop",
  "description": "A tiny parent whose engine is a black box refined by engine-logic.",
  "components": [
    {
      "id": "client"
    },
    {
      "id": "engine",
      "refined_by": [
        {
          "ontology": "engine-logic",
          "revision": "1"
        }
      ]
    },
    {
      "id": "gateway"
    },
    {
      "id": "metrics"
    }
  ],
  "interfaces": [
    {
      "id": "engine.run",
      "component": "engine",
      "name": "run",
      "errors": [
        {
          "code": "overloaded",
          "status": 503,
          "retryable": true
        }
      ],
      "latency_ms": 50,
      "behavior": [
        {
          "return": {
            "text": "=input.prompt + '!'"
          }
        }
      ],
      "latency_source": {
        "pinned": "measured in production"
      }
    },
    {
      "id": "gateway.handle",
      "component": "gateway",
      "name": "handle",
      "behavior": [
        {
          "call": "engine.run",
          "input": {
            "prompt": "=input.prompt"
          },
          "as": "r"
        },
        {
          "return": {
            "answer": "=vars.r.value.text"
          }
        }
      ]
    },
    {
      "id": "metrics.record",
      "component": "metrics",
      "name": "record",
      "latency_ms": 1,
      "behavior": [
        {
          "return": {}
        }
      ]
    }
  ],
  "links": [],
  "schemas": [],
  "flows": [
    {
      "id": "ask",
      "entry": {
        "caller": "client",
        "interface": "gateway.handle",
        "input": {
          "prompt": "hi"
        }
      }
    }
  ],
  "scenarios": [
    {
      "id": "ask-ok",
      "flow": "ask",
      "expect": [
        "result.ok",
        "result.value.answer == 'hi!'",
        "calls['engine.run'] == 1"
      ]
    },
    {
      "id": "ask-refined",
      "flow": "ask",
      "expect": [
        "result.ok",
        "result.value.answer == 'hi!'",
        "calls['engine.run'] == 1",
        "calls['engine/worker.execute'] == 1"
      ],
      "resolution": {
        "engine": "refined"
      }
    }
  ],
  "level": "system"
}
