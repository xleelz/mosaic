{
 "ifaces": {
  "schedule": {
   "kind": "function",
   "request": {
    "type": "object",
    "properties": {
     "throttle_prefills": {
      "type": "boolean",
      "default": false
     }
    }
   },
   "response": "SchedulerOutput",
   "errors": null
  },
  "update-from-output": {
   "kind": "function",
   "request": {
    "type": "object",
    "required": [
     "scheduler_output",
     "model_runner_output"
    ],
    "properties": {
     "scheduler_output": "SchedulerOutput",
     "model_runner_output": "ModelRunnerOutput"
    }
   },
   "response": "SchedKvEngineCoreOutputs",
   "errors": null
  },
  "add-request": {
   "kind": "function",
   "request": "SchedKvRequest",
   "response": {
    "type": "object",
    "properties": {
     "request_id": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "num_prompt_tokens": {
      "type": "integer"
     },
     "num_block_hashes": {
      "type": "integer"
     }
    }
   },
   "errors": [
    {
     "code": "assertion-error",
     "status": 0,
     "retryable": false
    }
   ]
  },
  "finish-requests": {
   "kind": "function",
   "request": {
    "type": "object",
    "required": [
     "request_ids"
    ],
    "properties": {
     "request_ids": {
      "type": [
       "array",
       "null"
      ],
      "default": null,
      "items": {
       "type": "string",
       "examples": [
        "chatcmpl-abc123"
       ]
      },
      "description": "null finishes every request (finish_requests(None))."
     },
     "finished_status": {
      "type": "string",
      "default": "FINISHED_ABORTED",
      "enum": [
       "FINISHED_ABORTED",
       "FINISHED_STOPPED",
       "FINISHED_LENGTH_CAPPED",
       "FINISHED_ERROR"
      ]
     }
    }
   },
   "response": {
    "type": "object",
    "properties": {
     "finished": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "errors": null
  },
  "reset-prefix-cache": {
   "kind": "function",
   "request": {
    "type": "object",
    "properties": {
     "reset_running_requests": {
      "type": "boolean",
      "default": false
     }
    }
   },
   "response": {
    "type": "object",
    "properties": {
     "reset": {
      "type": "boolean"
     }
    }
   },
   "errors": [
    {
     "code": "runtime-error",
     "status": 0,
     "retryable": false
    }
   ]
  },
  "has-requests": {
   "kind": "function",
   "request": {
    "type": "object"
   },
   "response": {
    "type": "boolean",
    "examples": [
     true
    ]
   },
   "errors": null
  },
  "pause-state": {
   "kind": "function",
   "request": {
    "type": "object"
   },
   "response": {
    "type": "string",
    "enum": [
     "UNPAUSED",
     "PAUSED_NEW",
     "PAUSED_ALL"
    ],
    "examples": [
     "UNPAUSED"
    ]
   },
   "errors": null
  },
  "set-pause-state": {
   "kind": "function",
   "request": {
    "type": "object",
    "required": [
     "pause_state"
    ],
    "properties": {
     "pause_state": {
      "type": "string",
      "enum": [
       "UNPAUSED",
       "PAUSED_NEW",
       "PAUSED_ALL"
      ],
      "examples": [
       "PAUSED_NEW"
      ]
     }
    }
   },
   "response": {
    "type": "object"
   },
   "errors": null
  },
  "reset-encoder-cache": {
   "kind": "function",
   "request": {
    "type": "object"
   },
   "response": {
    "type": "object"
   },
   "errors": null
  },
  "shutdown": {
   "kind": "function",
   "request": {
    "type": "object"
   },
   "response": {
    "type": "object"
   },
   "errors": null
  },
  "kv:get-kv-cache-configs": {
   "kind": "function",
   "request": {
    "type": "object",
    "required": [
     "available_memory"
    ],
    "properties": {
     "available_memory": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "examples": [
       [
        59745650279
       ]
      ]
     },
     "bytes_per_block": {
      "type": "integer",
      "default": 2097152,
      "description": "page_size_bytes * num_layers of the KV cache spec; 2 MiB for Llama-3.1-8B (16 tokens x 2 x 8 KV heads x 128 x 2 bytes x 32 layers)."
     }
    }
   },
   "response": {
    "type": "object",
    "properties": {
     "num_blocks": {
      "type": "integer",
      "examples": [
       28488
      ]
     }
    }
   },
   "errors": [
    {
     "code": "value-error",
     "status": 0,
     "retryable": false
    }
   ]
  },
  "update-draft-token-ids": {
   "kind": "function",
   "request": {
    "type": "object",
    "required": [
     "req_ids",
     "draft_token_ids"
    ],
    "properties": {
     "req_ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "draft_token_ids": {
      "type": "array",
      "items": {
       "type": "array",
       "items": {
        "type": "integer"
       }
      }
     }
    }
   },
   "response": {
    "type": "object",
    "properties": {
     "updated": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   },
   "errors": null
  }
 },
 "components": {
  "scheduler": {
   "id": "scheduler",
   "name": "Scheduler (AsyncScheduler when async scheduling is on)",
   "kind": "module",
   "parent": "engine-core",
   "layer": "scheduling",
   "summary": "The engine core's scheduler: owns request state, the waiting and running queues, and decides each step's batch."
  },
  "kv-cache-manager": {
   "id": "kv-cache-manager",
   "name": "KVCacheManager",
   "kind": "module",
   "parent": "engine-core",
   "layer": "kv-cache",
   "summary": "Allocates KV slots for scheduled tokens, finds prefix-cache hits, frees request blocks, keeps prefix-cache stats."
  },
  "kv-cache-utils": {
   "id": "kv-cache-utils",
   "name": "kv_cache_utils",
   "kind": "module",
   "parent": "kv-cache-manager",
   "layer": null,
   "summary": "Request block hashing (chained hashes of full blocks) and KV cache sizing helpers."
  }
 },
 "SchedKvRequest": {
  "type": "object",
  "required": [
   "request_id"
  ],
  "properties": {
   "request_id": {
    "type": "string",
    "examples": [
     "chatcmpl-abc123"
    ]
   },
   "prompt_token_ids": {
    "type": "array",
    "items": {
     "type": "integer"
    },
    "examples": [
     [
      128000,
      9906,
      1917,
      13,
      3639,
      374,
      279,
      6864,
      315,
      9822,
      30
     ]
    ]
   },
   "prompt_segments": {
    "type": "array",
    "default": [],
    "description": "Modeling device for long prompts: consecutive token runs named by content key (equal keys = equal tokens). Replaces prompt_token_ids when non-empty.",
    "items": {
     "type": "object",
     "required": [
      "key",
      "num_tokens"
     ],
     "properties": {
      "key": {
       "type": "string"
      },
      "num_tokens": {
       "type": "integer"
      }
     }
    }
   },
   "sampling_params": {
    "type": "object",
    "properties": {
     "max_tokens": {
      "type": "integer",
      "examples": [
       16
      ]
     },
     "min_tokens": {
      "type": "integer",
      "examples": [
       0
      ]
     },
     "temperature": {
      "type": "number",
      "examples": [
       0.0
      ]
     },
     "eos_token_id": {
      "type": "integer",
      "examples": [
       128009
      ]
     },
     "stop_token_ids": {
      "type": "array",
      "items": {
       "type": "integer"
      },
      "examples": [
       [
        128001,
        128008
       ]
      ]
     },
     "ignore_eos": {
      "type": "boolean",
      "examples": [
       false
      ]
     }
    }
   },
   "arrival_time": {
    "type": [
     "number",
     "null"
    ],
    "default": null,
    "description": "Engine arrival time; null means now."
   },
   "priority": {
    "type": "integer",
    "examples": [
     0
    ]
   },
   "grammar_id": {
    "type": [
     "string",
     "null"
    ],
    "default": null,
    "description": "Set when the request uses structured output (its compiled grammar)."
   },
   "client_index": {
    "type": "integer",
    "examples": [
     0
    ]
   }
  }
 },
 "SchedKvEngineCoreOutputs": {
  "type": "object",
  "properties": {
   "outputs": {
    "type": "array",
    "items": {
     "type": "object",
     "properties": {
      "request_id": {
       "type": "string"
      },
      "new_token_ids": {
       "type": "array",
       "items": {
        "type": "integer"
       }
      },
      "finish_reason": {
       "type": [
        "string",
        "null"
       ],
       "enum": [
        "stop",
        "length",
        "abort",
        "error",
        "repetition",
        null
       ]
      },
      "stop_reason": {},
      "num_cached_tokens": {
       "type": "integer"
      },
      "client_index": {
       "type": "integer"
      }
     }
    }
   },
   "finished_req_ids": {
    "type": "array",
    "items": {
     "type": "string"
    }
   }
  }
 }
}