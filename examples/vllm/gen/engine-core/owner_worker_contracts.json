{
 "init-device": {
  "kind": "rpc",
  "request": {
   "type": "object",
   "properties": {
    "device_type": {
     "type": "string",
     "default": "cuda"
    },
    "rank": {
     "type": "integer",
     "examples": [
      0
     ]
    }
   }
  },
  "response": {
   "type": "object",
   "properties": {
    "device": {
     "type": "string"
    },
    "requested_memory": {
     "type": "integer"
    },
    "runner": {
     "type": "string"
    }
   }
  },
  "errors": [
   {
    "code": "runtime-error",
    "status": 0,
    "retryable": false
   },
   {
    "code": "value-error",
    "status": 0,
    "retryable": false
   }
  ]
 },
 "load-model": {
  "kind": "rpc",
  "request": {
   "type": "object",
