 "execute-model": {
  "kind": "rpc",
  "request": {
   "allOf": [
    {
     "$ref": "SchedulerOutput"
    },
    {
     "type": "object",
     "properties": {
      "scheduled_spec_decode_tokens": {
       "type": "object",
       "description": "req_id -> draft token ids (-1 placeholders under async scheduling)"
      },
      "new_block_ids_to_zero": {
       "type": "array",
       "items": {
        "type": "integer"
       }
      },
      "preempted_req_ids": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "kv_connector_metadata": {
       "type": [
        "object",
        "null"
       ],
       "default": null,
       "description": "SchedulerOutput.kv_connector_metadata (with a KV transfer connector)"
      }
     }
    }
   ]
  },
  "response": {
   "anyOf": [
    {
     "$ref": "ModelRunnerOutput"
    },
    {
     "type": "null"
    }
   ]
  },
  "errors": null
 },
 "sample-tokens": {
  "kind": "rpc",
