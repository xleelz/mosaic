{
  "name": "fooext",
  "activationEvents": [
    "onCommand:fooext.run",
    "onLanguage:foo"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "fooext.run",
        "title": "%run%"
      },
      {
        "command": "fooext.stop",
        "title": "Stop"
      }
    ]
  }
}
