#!/bin/sh
# mcheck runs mosaic's model checker from any directory, with the Go environment
# it needs, so agents can call one fixed command (allowed as
# "Bash(.claude/skills/mosaic-generate/scripts/mcheck *)") without cd or env
# prefixes, which permission patterns don't match.
root=$(cd "$(dirname "$0")/../../../.." && pwd)
export PATH="/usr/local/go/bin:$PATH" GOFLAGS="${GOFLAGS:--mod=readonly}"
cd "$root" && exec go run ./internal/devtools/check "$@"
